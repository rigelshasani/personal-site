# Copy to .env.local for development. Every variable here is also required in
# production — the app builds without them and then fails at request time.

# ─── Auth ─────────────────────────────────────────────────────────────────────
# The canonical origin of the deployment. NextAuth builds OAuth callback URLs
# from this, so a wrong value fails the login round-trip.
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# GitHub OAuth app. Local and production need SEPARATE apps: an OAuth app has
# one callback URL, which must be <NEXTAUTH_URL>/api/auth/callback/github.
GITHUB_ID=
GITHUB_SECRET=

# Comma-separated GitHub logins allowed into /admin. Deliberately not
# NEXT_PUBLIC_ — admin status is resolved server-side.
ADMIN_GITHUB_LOGINS=

# ─── Database ─────────────────────────────────────────────────────────────────
# Runtime connection (pooled). Prisma also reads this for `migrate`, so run
# migrations with DATABASE_URL overridden to a direct (unpooled) connection.
DATABASE_URL=
# Scratch database Prisma uses to diff migrations. Must be a direct connection.
SHADOW_DATABASE_URL=

# ─── Site ─────────────────────────────────────────────────────────────────────
# Absolute base URL used by sitemap.xml, robots.txt and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content source. Defaults to "db"; set to "fs" to read and write the MDX files
# in src/content instead. The fs backend writes to disk and cannot be used on a
# serverless host.
# CONTENT_BACKEND=db
